#!/bin/sh -e

# The drop-in in grafana-server.service.d lets Grafana load the unsigned plugin.

if [ "$1" = "configure" ] && [ -d /run/systemd/system ]; then
	systemctl daemon-reload || true
	# restart only if already running, so a new or changed plugin is loaded
	systemctl try-restart grafana-server.service || true
fi
